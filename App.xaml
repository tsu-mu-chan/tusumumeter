<Application x:Class="YoutubeCounterApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YoutubeCounterApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <local:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter"/>
        <local:FirstTimeVisibilityConverter x:Key="FirstTimeVisibilityConverter"/>
    </Application.Resources>
</Application>