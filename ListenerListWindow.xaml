<Window x:Class="YoutubeCounterApp.ListenerListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👥 リスナー一覧帳" Height="580" Width="820"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Window.Resources>
        <!-- ★ ゆめかわコンボボックス トグルボタン用テンプレート -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="White" BorderBrush="#E2D9F3" BorderThickness="1.5" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A89BC2"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#C4B5FD"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#7C3AED"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ★ ゆめかわコンボボックス本体スタイル -->
        <Style x:Key="YumekawaComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#6B5B95"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="14,0,28,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide" Margin="0,4,0,0">
                                <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White" BorderBrush="#E2D9F3" BorderThickness="1.5" CornerRadius="12" Margin="0,3,0,5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Color="#6B5B95" Opacity="0.12" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#6B5B95"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3EEFB"/>
                                <Setter Property="Foreground" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBE3FA"/>
                                <Setter Property="Foreground" Value="#5C4A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外枠Border：ドラッグ移動対応 -->
    <Border Background="#F9F6FF" CornerRadius="20" Padding="20" BorderBrush="#E5DBFF" BorderThickness="2"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#6B5B95" Opacity="0.15" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー & ソート切替 & 検索 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="リスナー一覧" FontSize="18" FontWeight="Bold" Foreground="#6B5B95" VerticalAlignment="Center"/>
                </StackPanel>

<!-- コントロール群（今枠トグル ＋ ソート切り替え ＋ 検索ボックス） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    
                    <!-- 💡 新設：今枠のみ表示トグル -->
                    <CheckBox Content="🔴 今枠のみ" 
                              IsChecked="{Binding IsCurrentSessionOnly}" 
                              Foreground="#6B5B95" 
                              FontWeight="Bold" 
                              FontSize="12"
                              VerticalAlignment="Center" 
                              Margin="0,0,12,0" 
                              Cursor="Hand"/>

                    <ComboBox Width="150" Height="32" Margin="0,0,8,0"
                              Style="{StaticResource YumekawaComboBoxStyle}"
                              ItemsSource="{Binding SortOptions}" 
                              SelectedItem="{Binding SelectedSort}"/>

                    <TextBox Height="32" Width="160" VerticalContentAlignment="Center" Padding="8,0"
                             Text="{Binding SearchWord, UpdateSourceTrigger=PropertyChanged}"
                             Background="White" BorderBrush="#E2D9F3" BorderThickness="1.5" Foreground="#6B5B95" FontWeight="Bold">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="32" Height="32" Background="Transparent"
                        Foreground="#8F83A8" FontWeight="Bold" BorderThickness="0"
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- メインコンテンツ（左: 一覧 / 右: 詳細 & メモ） -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- リスナーリスト -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="8" Margin="0,0,10,0">
                    <ListBox ItemsSource="{Binding ListenersView}" SelectedItem="{Binding SelectedListener}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#F0EAF8" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- アイコン表示（フォールバック付き） -->
                                        <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center">
                                            <Border Background="#EDE8F5" CornerRadius="17"/>
                                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>

                                            <Border CornerRadius="17" ClipToBounds="True">
                                                <Image Source="{Binding IconUrl, Converter={StaticResource UrlToImageSourceConverter}}" 
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <!-- ユーザー名 ＆ 各種バッジ一覧 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#5C4A8A" FontSize="13" MaxWidth="110" TextTrimming="CharacterEllipsis"/>

                                                <!-- 🌱 初見バッジ -->
                                                <Border Background="#E8F8F0" CornerRadius="8" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CommentCount}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🌱 初見" FontSize="10" Foreground="#2E7D32" FontWeight="Bold"/>
                                                </Border>

                                                <!-- ★ メンバーシップバッジ -->
                                                <Border Background="#E0F2F1" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="★ Member" FontSize="10" Foreground="#00796B" FontWeight="Bold"/>
                                                </Border>

                                                <!-- 🎁 枠内メンギフバッジ（TextBlock分割でエラー防止） -->
                                                <Border Background="#FFF3E0" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentGifts}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🎁 " FontSize="10"/>
                                                        <TextBlock Text="{Binding CurrentGifts}" FontSize="10" Foreground="#E65100" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 💎 枠内ジュエルバッジ（TextBlock分割でエラー防止） -->
                                                <Border Background="#E1F5FE" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentJewels}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💎 " FontSize="10"/>
                                                        <TextBlock Text="{Binding CurrentJewels}" FontSize="10" Foreground="#0277BD" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding LastSeen, StringFormat='{}最終: {0:yyyy/MM/dd HH:mm}'}" FontSize="10" Foreground="#A9A0BF" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- コメント回数 -->
                                        <Border Grid.Column="2" Background="#F1EDFB" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CommentCount}" FontSize="11" FontWeight="Bold" Foreground="#7A68A6"/>
                                                <TextBlock Text=" 回" FontSize="11" FontWeight="Bold" Foreground="#7A68A6"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 右ペイン: 選択リスナー詳細 & メモ -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="16" Margin="10,0,0,0">
                    <Grid>
                        <TextBlock Text="リスナーを選択すると&#x0a;詳細とメモが表示されます ✨"
                                   TextAlignment="Center" Foreground="#B3A9C9" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding SelectedListener, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <StackPanel Visibility="{Binding SelectedListener, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedListener.Name}" FontSize="15" FontWeight="Bold" Foreground="#5C4A8A"/>
                                <Border Background="#E0F2F1" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedListener.IsMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="★ Member" FontSize="10" Foreground="#00796B" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedListener.FirstSeen, StringFormat='{}初見日: {0:yyyy/MM/dd HH:mm}'}" FontSize="11" Foreground="#8F83A8" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedListener.LastSeen, StringFormat='{}最終来訪: {0:yyyy/MM/dd HH:mm}'}" FontSize="11" Foreground="#8F83A8" Margin="0,0,0,4"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="通算コメント: " FontSize="11" Foreground="#8F83A8"/>
                                <TextBlock Text="{Binding SelectedListener.CommentCount}" FontSize="11" Foreground="#8F83A8"/>
                                <TextBlock Text=" 回" FontSize="11" Foreground="#8F83A8"/>
                            </StackPanel>

                            <Border Background="#F3EEFB" BorderBrush="#E2D9F3" BorderThickness="1" 
                                    CornerRadius="10" Padding="8,5" Margin="0,2,0,8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏰ 活動帯: " FontSize="11" FontWeight="Bold" Foreground="#7A68A6"/>
                                    <TextBlock Text="{Binding SelectedListener.PrimaryActiveTimeText}" FontSize="11" FontWeight="Bold" Foreground="#6B5B95"/>
                                </StackPanel>
                            </Border>

                            <!-- 枠内ギフト・ジュエルの詳細表示 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedListener.CurrentGifts}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="今枠メンギフ: " FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedListener.CurrentGifts}" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                <TextBlock Text=" 個" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedListener.CurrentJewels}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="今枠ジュエル: " FontSize="11" Foreground="#0277BD" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedListener.CurrentJewels}" FontSize="11" Foreground="#0277BD" FontWeight="Bold"/>
                                <TextBlock Text=" J" FontSize="11" Foreground="#0277BD" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock Text="📝 配信者メモ" FontSize="12" FontWeight="Bold" Foreground="#7A68A6" Margin="0,0,0,4"/>
                            <TextBox Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Padding="8" Background="#FBF9FD" BorderBrush="#EAE3F5"
                                     Text="{Binding SelectedListener.Memo, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Content="🗑️ このリスナーを削除する" 
                                    Height="32" 
                                    Margin="0,12,0,0"
                                    Background="#FFF1F2" 
                                    Foreground="#E11D48" 
                                    FontWeight="Bold" 
                                    FontSize="11"
                                    BorderBrush="#FECDD3"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding DeleteListenerCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="16"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- フッター -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <!-- 左側：わんコメインポートボタン -->
                <Button Content="📂 わんコメCSV取込" Width="140" Height="36" HorizontalAlignment="Left"
                        Background="#E0F2FE" Foreground="#0369A1" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ImportCsvCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- 右側：保存 ＆ 閉じる -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="メモを保存する" Width="120" Height="36" Margin="0,0,10,0"
                            Background="#EBE5FF" Foreground="#5C4A8A" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveChangesCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="閉じる" Width="90" Height="36"
                            Background="#FFDCC8" Foreground="#A06040" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>