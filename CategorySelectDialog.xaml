<Window x:Class="YoutubeCounterApp.CategorySelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カテゴリの選択" Height="280" Width="360"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Border Background="#FAF7FF" CornerRadius="20" Padding="20" BorderBrush="#E5DBFF" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#6B5B95" Opacity="0.15" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="📁 追加先カテゴリの選択" FontSize="16" FontWeight="Bold" Foreground="#6B5B95" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 対象ファイル名表示 -->
            <TextBlock Grid.Row="1" x:Name="TxtTargetName" Text="素材名" FontSize="12" Foreground="#8F83A8" 
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>

            <!-- カテゴリ選択ラジオボタン -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="24,0,0,0">
                <RadioButton x:Name="RbCounter" Content="🔢 カウンター (Counter)" Margin="0,0,0,10" Foreground="#5C4A8A" FontSize="13"/>
                <RadioButton x:Name="RbComment" Content="💬 コメント (Comment)" Margin="0,0,0,10" Foreground="#5C4A8A" FontSize="13"/>
                <RadioButton x:Name="RbReaction" Content="🤹 リアクション (Reaction)" Margin="0,0,0,10" Foreground="#5C4A8A" FontSize="13"/>
                <RadioButton x:Name="RbClock" Content="⏰ 時計 (Clock)" Foreground="#5C4A8A" FontSize="13"/>
            </StackPanel>

            <!-- ボタン列 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="キャンセル" Width="90" Height="36" Margin="0,0,10,0"
                        Background="#EBE7F5" Foreground="#7A68A6" FontWeight="Bold" BorderThickness="0"
                        Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="追加する ✨" Width="100" Height="36"
                        Background="#FFD7EA" Foreground="#8A436B" FontWeight="Bold" BorderThickness="0"
                        Click="BtnOk_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>