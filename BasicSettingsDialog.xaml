<Window x:Class="YoutubeCounterApp.BasicSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基本設定" Height="640" Width="400"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        FontFamily="BIZ UDPMaruGothic, HG丸ｺﾞｼｯｸM-PRO, Meiryo UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- テキストボックスの共通スタイル（カプセル・淡い境界線） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ラジオボタンの文字色調整 -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- チェックボックスの文字色調整 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- 外枠カード：メイン画面と完全一致のパステルグラデーション -->
    <Border CornerRadius="24" BorderBrush="#E2E8F0" BorderThickness="1.5" Background="#F8FAFC" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="4" Color="#64748B"/>
        </Border.Effect>

        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#FDE8EF" Offset="0"/>
                    <GradientStop Color="#E0F2FE" Offset="0.55"/>
                    <GradientStop Color="#EDE9FE" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- タイトルヘッダー -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16">
                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="基本設定" FontSize="18" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    <TextBlock Text=" ✨" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 設定コンテンツ領域 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Margin="2,0,6,0">

                        <!-- 💬 チャット取得モード -->
                        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0, 4, 0, 0" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💬 チャット取得モード" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,4"/>
                                <TextBlock Text="オーバーレイに反映するコメントの範囲を選択します。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <RadioButton Content="すべてのチャット（推奨：全件表示）"
                                             IsChecked="{Binding IsAllChatMode, Mode=TwoWay}" 
                                             Margin="0,0,0,8" />
                                <RadioButton Content="トップチャット（YouTube自動調整）"
                                             IsChecked="{Binding IsTopChatMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- ⏱️ 巡回インターバル -->
                        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0, 10, 0, 0" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⏱️ 巡回インターバル" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,4"/>
                                <TextBlock Text="画面の切り替え頻度や待機秒数を調整します。" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="配信監視の滞在時間:" VerticalAlignment="Center" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="TbStayDuration" Width="48" Height="26" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        <TextBlock Text=" 秒" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="オフライン時リトライ:" VerticalAlignment="Center" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="TbOfflineRetry" Width="48" Height="26" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        <TextBlock Text=" 秒" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 🔌 ポート番号 -->
                        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0, 10, 0, 0" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🔌 サーバーポート番号" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,4"/>
                                <TextBlock Text="他ソフトと競合している場合に変更してください（要再起動）。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="静的ファイル (HTTP):" VerticalAlignment="Center" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TbStaticPort" Width="64" Height="26" HorizontalAlignment="Right" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="通信 (WebSocket):" VerticalAlignment="Center" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TbWsPort" Width="64" Height="26" HorizontalAlignment="Right" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 🚀 動作設定 -->
                        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0, 10, 0, 0" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🚀 動作設定" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,6"/>
                                <CheckBox x:Name="CbAutoStart" Content="起動時に自動で監視を開始する" Margin="0,4,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- 👤 アカウント切り替え -->
                        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0, 10, 0, 0" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#64748B"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="👤 YouTube アカウント" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,4"/>
                                <TextBlock Text="ブランドアカウントの切り替えや再ログインを行います。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                
                                <Button x:Name="BtnSwitchAccount" 
                                        Content="アカウントを切替 / ログイン" 
                                        Height="38" 
                                        Background="#BAE6FD" 
                                        Foreground="#0369A1" 
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Click="BtnSwitchAccount_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="19"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- フッター操作エリア（閉じるボタン ＋ バージョン表記） -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="BtnClose" 
                            Content="とじる" 
                            Height="38" 
                            Width="140"
                            Background="#FED7AA" 
                            Foreground="#475569" 
                            FontWeight="SemiBold" 
                            FontSize="13"
                            BorderThickness="0" 
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- バージョン表記（ベタ書き） -->
                    <TextBlock Text="Version 4.0.0" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#94A3B8" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>